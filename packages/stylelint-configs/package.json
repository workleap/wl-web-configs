{
    "name": "@workleap/stylelint-configs",
    "version": "2.2.1",
    "description": "Workleap recommended Stylelint configurations.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-web-configs.git",
        "directory": "packages/stylelint-configs"
    },
    "files": [
        "src",
        "dist",
        "skills",
        "CHANGELOG.md"
    ],
    "type": "commonjs",
    "sideEffects": false,
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "prebuild": "pnpm rimraf dist",
        "build": "tsc --project tsconfig.build.json",
        "typecheck": "tsc"
    },
    "dependencies": {
        "stylelint-config-standard": "^41.0.0",
        "stylelint-prettier": "^5.1.0"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@workleap/typescript-configs": "workspace:*",
        "prettier": "3.9.10",
        "rimraf": "6.1.3",
        "stylelint": "18.0.0",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "prettier": "^3.9.10",
        "stylelint": "^18.0.0"
    },
    "peerDependenciesMeta": {
        "prettier": {
            "optional": true
        },
        "stylelint": {
            "optional": true
        }
    }
}
