{
    "name": "@workleap/rsbuild-configs",
    "author": "Workleap",
    "description": "Workleap recommended Rsbuild configurations.",
    "version": "4.1.2",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-web-configs.git",
        "directory": "packages/rsbuild-configs"
    },
    "type": "module",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "rslib build -c rslib.config.ts",
        "eslint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
        "typecheck": "tsgo",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "peerDependencies": {
        "@rsbuild/core": "^2.2.11",
        "@rspack/core": "^2.2.8"
    },
    "dependencies": {
        "@rsbuild/plugin-basic-ssl": "^2.0.0",
        "@rsbuild/plugin-image-compress": "^1.3.4",
        "@rsbuild/plugin-react": "^2.1.1",
        "@rsbuild/plugin-svgr": "^2.0.5",
        "core-js": "^3.50.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@rsbuild/core": "2.2.11",
        "@rslib/core": "1.0.3",
        "@rspack/core": "2.2.8",
        "@types/node": "26.6.4",
        "@typescript-eslint/parser": "8.71.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/eslint-configs": "workspace:*",
        "@workleap/rslib-configs": "workspace:*",
        "@workleap/typescript-configs": "workspace:*",
        "eslint": "9.39.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vitest": "5.0.3"
    }
}
