{
    "name": "@workleap/rsbuild-configs",
    "version": "5.1.2",
    "description": "Workleap recommended Rsbuild configurations.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-web-configs.git",
        "directory": "packages/rsbuild-configs"
    },
    "files": [
        "src",
        "dist",
        "skills",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rslib build -c rslib.config.ts",
        "typecheck": "tsc",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@rsbuild/plugin-basic-ssl": "^2.0.0",
        "@rsbuild/plugin-image-compress": "^1.3.4",
        "@rsbuild/plugin-react": "^2.1.1",
        "@rsbuild/plugin-svgr": "^2.0.5",
        "core-js": "^3.51.0"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@rspack/core": "2.3.1",
        "@types/node": "26.6.6",
        "@workleap/rslib-configs": "workspace:*",
        "@workleap/typescript-configs": "workspace:*",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "@rsbuild/core": "^2.3.1",
        "@rspack/core": "^2.3.1"
    }
}
