{
    "search.exclude": {
        "**/node_modules*": true,
        "**/dist*": true
    },

    // Formatting and linting: oxfmt and oxlint through the oxc extension. Type-aware like `pnpm oxlint`,
    // the extension picks up the installed oxlint-tsgolint.
    "oxc.typeAware": true,
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit"
    },
    "[html]": {
        "editor.formatOnSave": false
    },
    // oxfmt doesn't format CSS: Stylelint does, through stylelint-prettier and .prettierrc.json5.
    "[css]": {
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "explicit"
        }
    },

    // Languages
    // TypeScript 7 language service: the TypeScriptTeam.native-preview extension (.vscode/extensions.json).
    "typescript.preferences.useAliasesForRenames": false,

    "javascript.preferences.useAliasesForRenames": false,

    "html.format.enable": false,

    "css.validate": false, // Disables the default validation to use Stylelint instead

    // Settings for third parties that are frequently used
    "files.associations": {
        "*.snap": "javascriptreact",
        "turbo.json": "jsonc"
    },

    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "file": ".github/copilot/commit-message-instructions.md"
        }
    ]
}
