{
    "extends": "@workleap/typescript-configs/web-application.json",
    "compilerOptions": {
        "incremental": true,
        "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
        "types": ["node"]
    },
    // Includes the files in ".storybook" so they are type-checked and linted with type information.
    "include": [".storybook/*", "."],
    "exclude": ["dist", "node_modules"]
}
