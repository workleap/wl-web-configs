{
    "name": "@storybook-sample/rsbuild",
    "version": "0.0.0",
    "private": true,
    "description": "Storybook app using Rsbuild as the bundler.",
    "type": "module",
    "scripts": {
        "dev": "storybook dev -p 6006",
        "build": "storybook build",
        "serve-build": "pnpm http-server storybook-static -p 8080 -P http://localhost:8080? -c-1",
        "typecheck": "tsc"
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.0",
        "@rspack/core": "2.3.0",
        "@storybook/addon-a11y": "10.6.5",
        "@storybook/addon-links": "10.6.5",
        "@storybook/react": "10.6.5",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@workleap/browserslist-config": "workspace:*",
        "@workleap/rsbuild-configs": "workspace:*",
        "@workleap/typescript-configs": "workspace:*",
        "browserslist": "4.29.5",
        "http-server": "14.1.1",
        "storybook": "10.6.5",
        "storybook-react-rsbuild": "3.6.1",
        "typescript": "7.0.2"
    }
}
