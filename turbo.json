{
    "$schema": "./node_modules/turbo/schema.json",
    "ui": "tui",
    // .prettierrc.json5 configures stylelint-prettier in every project. As a global dependency, a change to it also
    // marks every project as changed for the CI's `--filter=...[base]`, which a task input doesn't.
    "globalDependencies": [".prettierrc.json5"],
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"],
            "outputs": []
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "dev-msw": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "env": ["USE_MSW", "NETLIFY", "VERBOSE"],
            "outputs": ["dist/**", "storybook-static/**"]
        },
        "serve-build": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        },
        "deploy": {
            "dependsOn": ["build"],
            "cache": false
        },
        "lint": {
            "dependsOn": ["//#oxlint", "//#oxfmt:check", "stylelint", "typecheck", "//#typecheck", "//#syncpack"]
        },
        "//#oxlint": {
            "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!**/*.md", "!**/*.css"],
            "outputs": []
        },
        "//#oxfmt:check": {
            "inputs": ["$TURBO_DEFAULT$", "!docs/**"],
            "outputs": []
        },
        "stylelint": {
            "dependsOn": ["transit"],
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": ["node_modules/.cache/stylelint"]
        },
        "//#typecheck": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "tsconfig.json", "!packages", "!samples", "!docs"],
            "outputs": ["node_modules/.cache/tsbuildinfo.json"]
        },
        "typecheck": {
            "dependsOn": ["transit"],
            "inputs": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "tsconfig.json", "tsconfig.build.json"],
            "outputs": ["node_modules/.cache/tsbuildinfo.json"]
        },
        "//#syncpack": {
            "inputs": [".syncpackrc.js", "package.json", "packages/**/package.json", "samples/**/package.json"]
        },
        "@rsbuild-sample/app#test": {
            "dependsOn": ["@workleap/swc-configs#build", "@rsbuild-sample/rslib-lib#build"],
            "outputs": ["node_modules/.cache/vitest/**"]
        },
        "@webpack-sample/app#test": {
            "dependsOn": ["@workleap/swc-configs#build", "@webpack-sample/tsup-lib#build"],
            "outputs": ["node_modules/.cache/jest/**"]
        },
        "test": {
            "dependsOn": ["@workleap/swc-configs#build"],
            "outputs": ["node_modules/.cache/vitest/**", "node_modules/.cache/jest/**"]
        }
    }
}
